generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Resume {
  id           String      @id @default(cuid())
  filename     String
  uploadDate   DateTime    @default(now())
  pdfText      String
  jdText       String?
  analysisJson String?
  /// JSON map of moduleKey -> { status: "ok"|"error", error?: string, lastRunAt: ISOString }
  moduleStatus String?
  /// JSON: { promptTokens, completionTokens, totalTokens, durationMs, estimatedCostUSD?, model, runAt, modulesRun: number }
  lastRunStats String?
  status       String      @default("uploaded")
  errorMessage String?
  tag          String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  recordings   Recording[]
  sourceType   String      @default("pdf")
  briefJson    String?
  briefStatus  String      @default("idle")
  briefError   String?
  briefRunId   String?
  analysisRuns AnalysisRun[]

  @@index([uploadDate])
  @@index([status])
  @@index([tag])
}

model Recording {
  id        String   @id @default(cuid())
  resumeId  String
  filename  String
  duration  Int
  /// Path to audio file relative to RECORDINGS_DIR (preferred). When present, `data` is ignored.
  path      String?
  /// MIME type of the audio file (defaults to audio/webm).
  mimeType  String?
  /// Legacy: inline BLOB. Nullable so new rows can leave it empty after migration to filesystem.
  data      Bytes?
  createdAt DateTime @default(now())
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt])
}

model Settings {
  id              Int      @id @default(1)
  provider        String   @default("CometAPI")
  apiKeyCometapi  String   @default("")
  model           String   @default("gemini-3.1-pro-preview")
  baseUrl         String   @default("")
  region          String   @default("us-west-2")
  authMode        String   @default("default")
  apiKeyEncrypted String   @default("")
  bedrockKeyEncrypted String @default("")
  updatedAt       DateTime @updatedAt
}

model AnalysisRun {
  id          String   @id @default(cuid())
  resumeId    String
  status      String   @default("running")
  mode        String
  provider    String
  model       String
  configJson  String
  resultJson  String?
  error       String?
  createdAt   DateTime @default(now())
  completedAt DateTime?
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt])
  @@index([status, createdAt])
}
