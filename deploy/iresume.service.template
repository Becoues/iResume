[Unit]
Description=iResume interview preparation workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__APP_DIR__
EnvironmentFile=%h/.config/iresume/runtime.env
Environment=NODE_ENV=production
ExecStart=__NODE__ __APP_DIR__/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3001
Restart=on-failure
RestartSec=5
TimeoutStopSec=100
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
